# PostgreSQL bootstrap
POSTGRES_SUPERUSER_PASSWORD=local-postgres-password

# LocalStack (local AWS S3 and SQS APIs)
S3_BUCKET=loan-user-uploads
S3_REGION=us-east-1
S3_INTERNAL_ENDPOINT_URL=http://localstack:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=loan-upload-events
PRESIGNED_URL_EXPIRY_SECONDS=900

# Backend and n8n
BACKEND_PUBLIC_URL=http://localhost:8000
N8N_ENCRYPTION_KEY=replace-with-a-long-random-local-key
N8N_MATCH_WEBHOOK_URL=http://n8n:5678/webhook/user-loan-matching
N8N_WEBHOOK_SECRET=replace-before-enabling-workflow-b

# Gemini API key for Workflow B qualitative checks. Leave blank in git.
# Put the real key only in the untracked .env file and in an n8n Header Auth
# credential named "Gemini API Key" (header name: x-goog-api-key).
GEMINI_API_KEY=

# Workflow C never sends to the CSV address. It derives aliases such as
# owner+loan-<user_id>@gmail.com from this base. SES_FROM_EMAIL is the
# verified SES sender; leave it blank to use the same Gmail base.
NOTIFICATION_TEST_EMAIL_BASE=owner@gmail.com
SES_FROM_EMAIL=

